{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "functions/lib",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": [
        "./shared/*"
      ],
      "@/*": [
        "client/src/*"
      ]
    }
  },
  "compileOnSave": true,
  "include": [
    "functions/src",
    "shared",
    "client"
  ]
}
