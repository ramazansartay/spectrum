{
  "functions": {
    "source": ".",
    "codebase": "default",
    "predeploy": [
      "npm install",
      "npm run build"
    ],
    "postdeploy": [
      "rm -rf functions/lib"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "apiHandler"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
